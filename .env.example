# Trustate Probate Automation — Environment Variables
# Copy this file to .env and fill in your values

# === API Server ===
TRUSTATE_API_HOST=0.0.0.0
TRUSTATE_API_PORT=8000
TRUSTATE_DATA_DIR=data/cases

# === CRM (GoHighLevel / HubSpot / Salesforce) ===
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

# === Email — SendGrid ===
SENDGRID_API_KEY=

# === SMS — Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Court E-Filing — Tyler Technologies ===
EFILING_API_URL=
EFILING_API_KEY=
EFILING_FIRM_ID=

# === Trustate Import API ===
# Get these from app.trustate.com -> Profile menu (top right) -> Account page
TRUSTATE_API_HOST=https://app.trustate.com
TRUSTATE_PUBLIC_TOKEN=
TRUSTATE_PRIVATE_KEY=
# Identifies this pipeline in Trustate's IntegrationContext.source
TRUSTATE_SOURCE_ID=trustate-automation-pipeline

# === PandaDoc (fee agreement e-signature) ===
# API key: PandaDoc -> Settings -> API & Integrations -> API Key
PANDADOC_API_KEY=
# Template UUID: open your fee agreement template in PandaDoc,
# grab the UUID from the URL
PANDADOC_FEE_AGREEMENT_TEMPLATE_ID=
# Optional shared secret for verifying PandaDoc webhook signatures
PANDADOC_WEBHOOK_SECRET=

# === GoHighLevel (CRM) ===
# Optional shared secret for verifying GHL webhook signatures
GHL_WEBHOOK_SECRET=

# === Cognito Forms intake URL ===
# The public form URL — we'll append ?case_id=<uuid> automatically
INTAKE_FORM_BASE_URL=https://www.cognitoforms.com/YourCompany/ProbateIntake

# === Aircall (call recordings) ===
AIRCALL_API_ID=
AIRCALL_API_TOKEN=

# === Notion (internal tracking) ===
NOTION_API_KEY=
NOTION_DATABASE_ID=

# === Client Portal URLs ===
PORTAL_BASE_URL=https://portal.trustate.com
INTAKE_FORM_BASE_URL=https://intake.trustate.com/form
