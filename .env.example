# Trustate Probate Automation — Environment Variables
# Copy this file to .env and fill in your values

# === API Server ===
TRUSTATE_API_HOST=0.0.0.0
TRUSTATE_API_PORT=8000
TRUSTATE_DATA_DIR=data/cases

# === CRM (GoHighLevel / HubSpot / Salesforce) ===
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

# === Email — SendGrid ===
SENDGRID_API_KEY=

# === SMS — Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Court E-Filing — Tyler Technologies ===
EFILING_API_URL=
EFILING_API_KEY=
EFILING_FIRM_ID=

# === Aircall (call recordings) ===
AIRCALL_API_ID=
AIRCALL_API_TOKEN=

# === Notion (internal tracking) ===
NOTION_API_KEY=
NOTION_DATABASE_ID=

# === Client Portal URLs ===
PORTAL_BASE_URL=https://portal.trustate.com
INTAKE_FORM_BASE_URL=https://intake.trustate.com/form
