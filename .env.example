# Aircall API credentials
AIRCALL_API_ID=your_aircall_api_id
AIRCALL_API_TOKEN=your_aircall_api_token

# GoHighLevel API credentials
GHL_API_TOKEN=your_ghl_private_integration_token
GHL_API_VERSION=2021-07-28

# Google Service Account credentials JSON file path
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Slack webhook URL for notifying the closer
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Optional: webhook secret for verifying GHL requests
WEBHOOK_SECRET=your_optional_webhook_secret
